chparam -set BY 8 -set LOGM 4 -set CSC 1 drift_checker
hierarchy -top drift_checker
synth -top drift_checker
dfflibmap -liberty synth/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty synth/sky130_fd_sc_hd__tt_025C_1v80.lib
opt_clean
stat -liberty synth/sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog -noattr synth/out/drift_checker_8_4_c1.v
